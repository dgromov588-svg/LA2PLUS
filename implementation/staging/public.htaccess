Options -Indexes
DirectoryIndex index.php
Require all granted
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mime_module>
AddHandler application/x-httpd-alt-php83___lsphp .php .php8 .phtml
</IfModule>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://new.la2plus.com%{REQUEST_URI} [R=301,L]
RewriteRule ^\.well-known/acme-challenge/[-A-Za-z0-9_]+$ - [L]
RewriteRule (^|/)\. - [F,L]
RewriteRule (?:^|/)(?:error_log|[^/]+\.(?:ini|log|bak|sql|sqlite|db|env|jsonl))$ - [F,L,NC]
RewriteRule ^cms-private(?:/|$) - [F,L,NC]
RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
RewriteRule \.(?:php[0-9]?|phtml|phar)(?:/|$) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
